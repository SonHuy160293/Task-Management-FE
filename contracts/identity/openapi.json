            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Integration-Key",
            "in": "header",
            "description": "Integration API key configured in IntegrationApi:ApiKeys.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevFlow.Identity.Contracts.UserIntegrationDto"
